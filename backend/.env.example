# 复制为 .env 后按需改。默认值指向 backend/.pgdata 起的本地实例（端口 55433）
DATABASE_URL=postgresql+psycopg://miyun@127.0.0.1:55433/miyun
DEMO_DISTRICT=北京市密云区
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

# B4：令牌密钥与演示口令。换 SECRET_KEY = 所有已签发令牌立即失效；上线前两处都必须改
SECRET_KEY=miyun-demo-secret-change-me
TOKEN_TTL_MIN=480
DEMO_PASSWORD=miyun@2026
